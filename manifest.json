{
  "manifest_version": 3,
  "name": "Continuous Sanity",
  "version": "0.2.0",
  "description": "Leave in-context feedback on any staging build. No integration required by the team you're testing.",
  "icons": {
    "16": "icons/continuous-sanity-mark-cropped-v1.png",
    "48": "icons/continuous-sanity-mark-cropped-v1.png",
    "128": "icons/continuous-sanity-mark-cropped-v1.png"
  },
  "permissions": ["storage", "activeTab", "scripting", "sidePanel", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {},
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
